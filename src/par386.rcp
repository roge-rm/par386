#include "palm/resource.h"

VERSION ID 1 kAppVersion

// Ask the AlphaSmart Dana for its wide display.
DATA "wTap" ID 1000 "../res/wtap.bin"

ICONFAMILYEX
BEGIN
  BITMAP "../res/icon-1.bmp" BPP 1
  BITMAP "../res/icon-2.bmp" BPP 2
  BITMAP "../res/icon-4.bmp" BPP 4
  BITMAP "../res/icon-8.bmp" BPP 8 TRANSPARENT 255 0 255
  BITMAP "../res/icon-16.bmp" BPP 16 TRANSPARENT 255 0 255
  BITMAP "../res/icon-hd-8.bmp" BPP 8 TRANSPARENT 255 0 255 DENSITY 144
  BITMAP "../res/icon-hd-16.bmp" BPP 16 TRANSPARENT 255 0 255 DENSITY 144
END

SMALLICONFAMILYEX
BEGIN
  BITMAP "../res/small-1.bmp" BPP 1
  BITMAP "../res/small-2.bmp" BPP 2
  BITMAP "../res/small-4.bmp" BPP 4
  BITMAP "../res/small-8.bmp" BPP 8 TRANSPARENT 255 0 255
  BITMAP "../res/small-16.bmp" BPP 16 TRANSPARENT 255 0 255
  BITMAP "../res/small-hd-8.bmp" BPP 8 TRANSPARENT 255 0 255 DENSITY 144
  BITMAP "../res/small-hd-16.bmp" BPP 16 TRANSPARENT 255 0 255 DENSITY 144
END

FORM ID MainForm AT (0 0 160 160)
NOFRAME
USABLE
BEGIN
END

ALERT ID RomIncompatibleAlert
ERROR
BEGIN
  TITLE "Par 386"
  MESSAGE "Par 386 needs Palm OS 3.1 or newer."
  BUTTONS "OK"
END

ALERT ID ScreenAlert
ERROR
BEGIN
  TITLE "Par 386"
  MESSAGE "Par 386 couldn't set up the screen. Try closing other apps first."
  BUTTONS "OK"
END

ALERT ID MemoryAlert
ERROR
BEGIN
  TITLE "Par 386"
  MESSAGE "There's not enough memory for the screen, so Par 386 will close. A round in play is kept to continue."
  BUTTONS "OK"
END
